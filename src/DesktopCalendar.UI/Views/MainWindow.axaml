<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopCalendar.UI.ViewModels"
        xmlns:views="using:DesktopCalendar.UI.Views"
        x:Class="DesktopCalendar.UI.Views.MainWindow"
        Title="Desktop Calendar"
        Width="880" Height="640"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar навигации -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Desktop Calendar"
                           FontSize="18" FontWeight="SemiBold" Margin="16,16,16,12" />
                <ListBox x:Name="Sidebar"
                         ItemsSource="{Binding Sections}"
                         SelectedIndex="{Binding SelectedSectionIndex}"
                         Margin="8,0,8,8"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="8" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Область контента: переключается по SelectedSectionIndex -->
        <Panel Grid.Column="1">
            <views:MonitorSectionView IsVisible="{Binding IsMonitorVisible}" />
            <!-- Разделы 1..3 — заглушки до M5 -->
            <StackPanel IsVisible="{Binding IsLayoutVisible}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="Расположение" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Будет реализовано в M5" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsCalendarVisible}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="Календарь" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Будет реализовано в M5" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
            <StackPanel IsVisible="{Binding IsGeneralVisible}"
                        VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="Общие" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Будет реализовано в M5/M6" Foreground="Gray" HorizontalAlignment="Center" />
            </StackPanel>
        </Panel>
    </Grid>
</Window>
