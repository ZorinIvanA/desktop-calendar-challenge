<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DesktopCalendar.UI.ViewModels"
        xmlns:views="using:DesktopCalendar.UI.Views"
        x:Class="DesktopCalendar.UI.Views.MainWindow"
        Title="Desktop Calendar"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="220,*">
        <!-- Sidebar навигации -->
        <Border Grid.Column="0" Background="{DynamicResource SystemControlBackgroundAltMediumBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="Desktop Calendar"
                           FontSize="18" FontWeight="SemiBold" Margin="16,16,16,12" />
                <ListBox x:Name="Sidebar"
                         ItemsSource="{Binding Sections}"
                         SelectedIndex="{Binding SelectedSectionIndex}"
                         Margin="8,0,8,8"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="8" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Область контента: DataTemplate-селектор по типу активной section-VM -->
        <ContentControl Grid.Column="1" Content="{Binding ActiveSection}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:MonitorSectionViewModel}">
                    <views:MonitorSectionView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:LayoutSectionViewModel}">
                    <views:LayoutSectionView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:CalendarSectionViewModel}">
                    <views:CalendarSectionView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:GeneralSectionViewModel}">
                    <views:GeneralSectionView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>
    </Grid>
</Window>
