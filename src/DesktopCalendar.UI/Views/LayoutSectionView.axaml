<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DesktopCalendar.UI.ViewModels"
             xmlns:s="using:DesktopCalendar.Core.Settings"
             x:Class="DesktopCalendar.UI.Views.LayoutSectionView">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">

            <TextBlock Text="Расположение" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Выберите точку привязки календаря на экране и отступ от края."
                       Foreground="Gray" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="320,*" Margin="0,8,0,0">

                <!-- Схема с 8 точками привязки -->
                <Border Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="8" Background="#22000000">
                    <Canvas Width="280" Height="180" HorizontalAlignment="Center">
                        <!-- Контур экрана -->
                        <Border Canvas.Left="20" Canvas.Top="15" Width="240" Height="150"
                                BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Background="#11000000"/>

                        <!-- 8 кнопок-точек привязки. Координаты = левый-верхний угол кнопки 28×28,
                             ЦЕНТР кнопки совмещён с углом/ребром/центром экрана 240×150 на (20,15). -->
                        <RepeatButton Classes="anchor" Canvas.Left="6" Canvas.Top="1"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.TopLeft}" />
                        <RepeatButton Classes="anchor" Canvas.Left="126" Canvas.Top="1"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.TopCenter}" />
                        <RepeatButton Classes="anchor" Canvas.Left="246" Canvas.Top="1"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.TopRight}" />

                        <RepeatButton Classes="anchor" Canvas.Left="6" Canvas.Top="76"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.CenterLeft}" />
                        <RepeatButton Classes="anchor" Canvas.Left="246" Canvas.Top="76"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.CenterRight}" />

                        <RepeatButton Classes="anchor" Canvas.Left="6" Canvas.Top="151"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.BottomLeft}" />
                        <RepeatButton Classes="anchor" Canvas.Left="126" Canvas.Top="151"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.BottomCenter}" />
                        <RepeatButton Classes="anchor" Canvas.Left="246" Canvas.Top="151"
                                      Command="{Binding $parent[UserControl].DataContext.SelectAnchorCommand}"
                                      CommandParameter="{x:Static s:Anchor.BottomRight}" />
                    </Canvas>
                </Border>

                <!-- Поля ввода -->
                <StackPanel Grid.Column="1" Spacing="12" Margin="16,0,0,0" VerticalAlignment="Top">
                    <TextBlock Text="Текущая привязка:" Foreground="Gray" />
                    <TextBlock Text="{Binding SelectedAnchor}" FontSize="16" FontWeight="SemiBold" />

                    <TextBlock Text="Отступ от края (px):" Margin="0,12,0,0" Foreground="Gray" />
                    <NumericUpDown Value="{Binding MarginPx}" Minimum="0" Maximum="9999" Increment="1" Width="160"
                                   HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <!-- Превью -->
            <Border Background="#22000000" BorderBrush="Gray" BorderThickness="1"
                    CornerRadius="8" Padding="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="Превью" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <Image Stretch="Uniform" MaxHeight="320" HorizontalAlignment="Center"
                           Source="{Binding Preview.Bitmap}" />
                    <TextBlock Foreground="Gray" HorizontalAlignment="Center" TextWrapping="Wrap"
                               Text="{Binding Preview.Status}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
