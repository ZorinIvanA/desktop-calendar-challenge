<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DesktopCalendar.UI.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <!-- Стиль для точек привязки в разделе «Расположение».
             28×28; Canvas-координаты в LayoutSectionView задают левый-верхний угол,
             рассчитаны так, чтобы ЦЕНТР точки лежал на угле/ребре/центре экрана. -->
        <Style Selector="RepeatButton.anchor">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#CCFFFFFF" />
            <Setter Property="BorderBrush" Value="Gray" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Content" Value="" />
        </Style>
        <Style Selector="RepeatButton.anchor:pointerover">
            <Setter Property="Background" Value="Orange" />
        </Style>
    </Application.Styles>
</Application>
